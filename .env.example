GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# low keeps dish resolution + recipe extraction fast; raise only if quality drops.
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT=30
GROQ_MAX_TOKENS=1200
GROQ_MAX_RETRIES=1

# Dish photos (Wikimedia Commons; no API key needed)
PHOTO_ENABLED=true
PHOTO_TIMEOUT=4
PHOTO_CACHE_TTL=3600
PHOTO_FAILURE_TTL=600
# Wikimedia asks for a descriptive User-Agent with a contact URL/email.
PHOTO_USER_AGENT=QuickChef/1.0 (https://github.com/quickchef-demo; quickchef-demo@users.noreply.github.com)

# Feedback capture for growing the golden dataset (best-effort; never blocks the UI)
FEEDBACK_ENABLED=true
# Default queue: evals/golden/feedback.jsonl (use an absolute path to override)
# FEEDBACK_PATH=/absolute/path/to/feedback.jsonl

# Pricing (optional overrides; defaults shown)
DELIVERY_FEE=25
FREE_DELIVERY_ABOVE=199
HANDLING_FEE=9

# LangSmith tracing & evals (optional; leave key blank to disable tracing)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=quickchef
# Set your region's endpoint. US (default) = https://api.smith.langchain.com
# EU accounts must use: https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
